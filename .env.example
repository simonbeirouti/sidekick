VITE_LLM_PROVIDER=openai

# Optional local Supabase overrides for the Rust auth bridge.
# The desktop app falls back to local Supabase defaults when these are unset.
# SIDEKICK_SUPABASE_URL=http://127.0.0.1:64321
# SIDEKICK_SUPABASE_PUBLISHABLE_KEY=
# SIDEKICK_SUPABASE_SECRET_KEY=

# OpenAI
VITE_OPENAI_API_KEY=
VITE_OPENAI_MODEL=gpt-4.1-mini

# Ollama
VITE_OLLAMA_MODEL=gemma4:26b
VITE_OLLAMA_BASE_URL=http://127.0.0.1:11434
